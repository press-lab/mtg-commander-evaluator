DATABASE_URL=postgresql://mtg_user:mtg_password@localhost:5432/mtg_evaluator
SCRYFALL_RATE_LIMIT_MS=100
DATA_DIR=./data
LOG_LEVEL=INFO

# Classifier: deepseek | anthropic | stub
CLASSIFIER=deepseek

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Classification runner
CLASSIFIER_WORKERS=5
CLASSIFIER_RETRY_ATTEMPTS=3
CLASSIFIER_RETRY_DELAY_S=2.0

# EDHREC top cards filter (2year recommended; also valid: year, month, week)
EDHREC_TOP_URL=https://json.edhrec.com/pages/top/2year.json
EDHREC_TOP_N=5000
